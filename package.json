{
  "name": "tether",
  "version": "0.0.0",
  "private": true,
  "description": "A desktop WYSIWYG Markdown editor for local and SSH/SFTP workspaces.",
  "author": "Yingjie",
  "main": "src/main/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "electron .",
    "build": "vite build",
    "check": "vite build",
    "package:win": "node scripts/package-win-portable.cjs",
    "package:mac": "vite build && electron-builder --mac --arm64 && node scripts/verify-mac-package.cjs",
    "test": "node --test tests/*.test.cjs tests/*.test.mjs",
    "test:backend": "node --test tests/*.test.cjs",
    "test:renderer": "node --test tests/*.test.mjs",
    "ssh:smoke": "node scripts/ssh-smoke.cjs"
  },
  "build": {
    "appId": "app.tether.markdown",
    "productName": "Tether",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "src/main/**",
      "src/shared/**",
      "samples/**",
      "resources/**"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "resources/tether-icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ]
    }
  },
  "dependencies": {
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sass": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/view": "^6.43.6",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/instrument-sans": "^5.2.8",
    "@fontsource/newsreader": "^5.2.10",
    "@lezer/highlight": "^1.2.3",
    "@milkdown/crepe": "^7.21.2",
    "@milkdown/kit": "^7.21.2",
    "lucide-react": "^0.468.0",
    "mdast-util-gfm-footnote": "^2.1.0",
    "micromark-extension-gfm-footnote": "^2.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ssh2-sftp-client": "^11.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "rcedit": "^4.0.1",
    "vite": "^8.1.4"
  }
}
