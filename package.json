{
  "name": "tether",
  "version": "0.0.0",
  "private": true,
  "description": "A lightweight desktop prototype for live-previewing Markdown workspaces over SSH/SFTP and local files.",
  "author": "Yingjie",
  "main": "src/main/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "electron .",
    "build": "vite build",
    "check": "vite build",
    "package:win": "node scripts/package-win-portable.cjs",
    "package:mac": "vite build && electron-builder --mac --arm64",
    "test": "node --test tests/*.test.cjs tests/*.test.mjs",
    "test:backend": "node --test tests/*.test.cjs",
    "test:renderer": "node --test tests/*.test.mjs",
    "ssh:smoke": "node scripts/ssh-smoke.cjs"
  },
  "build": {
    "appId": "app.tether.markdown",
    "productName": "Tether",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "src/main/**",
      "samples/**",
      "resources/**"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "resources/tether-icon.icns",
      "target": [
        { "target": "dmg", "arch": ["arm64"] },
        { "target": "zip", "arch": ["arm64"] }
      ]
    }
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/instrument-sans": "^5.2.8",
    "@fontsource/newsreader": "^5.2.10",
    "katex": "^0.16.22",
    "lucide-react": "^0.468.0",
    "mermaid": "^11.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "ssh2-sftp-client": "^11.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.5.0",
    "electron": "^31.7.0",
    "electron-builder": "^25.1.8",
    "rcedit": "^4.0.1",
    "vite": "^5.4.11"
  }
}
